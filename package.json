{
  "name": "poc-ng-element",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:dev": "ng build --configuration development",
    "build:elements": "ng build --configuration elements",
    "build:elements:dev": "ng build --configuration development --main=src/main-elements.ts",
    "concat:elements": "node concat.js",
    "package:elements": "npm run build:elements && npm run concat:elements",
    "package:tgz": "npm run package:elements && npm pack",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:elements": "http-server dist -p 4200",
    "clean": "rmdir /s /q dist .angular\\cache node_modules\\.cache 2>nul || echo Cache cleared",
    "clean:dist": "rmdir /s /q dist 2>nul || echo Dist folder cleared",
    "clean:cache": "rmdir /s /q .angular\\cache node_modules\\.cache 2>nul || echo Angular cache cleared",
    "clean:install": "npm run clean && npm install",
    "clean:build": "npm run clean:dist && npm run build:dev",
    "clean:build:prod": "npm run clean:dist && npm run build",
    "rebuild": "npm run clean:install && npm run build:dev",
    "fresh-start": "npm run clean && npm install && npm run build:dev && npm start",
    "demo:elements": "npm run package:elements && npm run serve:elements"
  },
  "private": false,
  "main": "dist/http-mock-manager.js",
  "types": "index.d.ts",
  "files": [
    "dist/http-mock-manager.js",
    "dist/demo.html",
    "README.md",
    "USAGE.md",
    "index.d.ts"
  ],
  "keywords": [
    "angular",
    "custom-element",
    "web-component",
    "http-mock",
    "standalone",
    "signals",
    "zoneless"
  ],
  "author": "Pedro",
  "license": "MIT",
  "description": "Self-contained Angular 20 custom element for HTTP Mock Management",
  "devDependencies": {
    "@angular/animations": "^20.3.12",
    "@angular/build": "^20.3.10",
    "@angular/cli": "^20.3.10",
    "@angular/common": "^20.3.12",
    "@angular/compiler": "^20.3.12",
    "@angular/compiler-cli": "^20.3.12",
    "@angular/core": "^20.3.12",
    "@angular/elements": "^20.3.12",
    "@angular/forms": "^20.3.12",
    "@angular/platform-browser": "^20.3.12",
    "@angular/platform-browser-dynamic": "^20.3.12",
    "@angular/router": "^20.3.12",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^18.7.0",
    "concat": "^1.0.3",
    "fs-extra": "^11.1.0",
    "http-server": "^14.1.1",
    "jasmine-core": "~5.4.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "typescript": "~5.9.3"
  }
}
